Bootstrap: docker
From: osrf/ros:melodic-desktop-full

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/jackal_ws/src

%files
    . /jackal_ws/src/the-barn-challenge

%post -c /bin/bash
    # System dependencies
    apt-get -y update && apt-get -y upgrade
    apt-get -y install \
        git curl \
        ros-melodic-jackal-simulator \
        ros-melodic-jackal-desktop \
        ros-melodic-jackal-navigation

    ln -s /usr/include/cdd /usr/include/cddlib

    # Python environment
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    mv /root/.local/bin/uv /bin/uv
    mv /root/.local/bin/uvx /bin/uvx
    export UV_PYTHON_INSTALL_DIR="/opt/uv_python"

    uv venv /opt/venv --python 3.9
    export VIRTUAL_ENV="/opt/venv"
    export PATH="$VIRTUAL_ENV/bin:$PATH"

    uv pip install \
        defusedxml \
        rospkg \
        netifaces \
        numpy \
        transforms3d \
        scipy \
        scikit-learn \

    git clone --branch v0.5.5 https://github.com/acados/acados.git && \
        cd /acados && git submodule update --recursive --init && \
        mkdir -p build && cd build && \
        cmake -DACADOS_WITH_QPOASES=ON .. \
        && make install -j4 

    export ACADOS_SOURCE_DIR="/acados"
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:"$ACADOS_SOURCE_DIR/lib"
    uv pip install -e "$ACADOS_SOURCE_DIR/interfaces/acados_template"
    python -c "from acados_template import get_tera; get_tera(tera_version='0.0.34', force_download=True)"

    
    # Build workspace
    source /opt/ros/melodic/setup.bash
    cd /jackal_ws
    rosdep init && rosdep update
    catkin_make

%environment
    export VIRTUAL_ENV="/opt/venv"
    export PATH="$VIRTUAL_ENV/bin:$PATH"
    export UV_PYTHON_INSTALL_DIR="/opt/uv_python"
    export ACADOS_SOURCE_DIR="/acados"
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:"$ACADOS_SOURCE_DIR/lib"